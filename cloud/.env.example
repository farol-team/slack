# Required: bot tokens are resolved per Slack team from the SaaS control plane
FAROL_SAAS_URL=https://your-saas-host
INTERNAL_API_SECRET=shared-secret-with-saas
SLACK_SIGNING_SECRET=your-signing-secret

# Public base URL of this cloud service — agents reach the memory
# gateway at ${FAROL_CLOUD_PUBLIC_URL}/memory/mcp (use your tunnel in dev)
FAROL_CLOUD_PUBLIC_URL=https://your-cloud-host

# OpenViking must run with auth_mode="trusted" + this root key in ov.conf
OPENVIKING_ROOT_KEY=your-openviking-root-key
