# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Secret used for session JWT signing

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # PostgreSQL connection string (postgres://user:pass@host:port/db)

# ── Slack (OIDC login + "Add to Slack" bot install) ────────────
SLACK_CLIENT_ID=          # Slack app client id
SLACK_CLIENT_SECRET=      # Slack app client secret

# ── Admin Role ──────────────────────────────────────────────────
OWNER_EMAILS=             # Comma-separated emails that get role "admin" on sign-in

# ── URLs / internal ─────────────────────────────────────────────
PUBLIC_URL=               # Public base URL of this app (e.g. https://app.example.com)
INTERNAL_API_SECRET=      # Shared secret for SaaS <-> cloud internal calls
OPENTAG_CLOUD_URL=        # Base URL of the cloud service (data plane)
