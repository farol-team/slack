{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OV Runner",
  "version": "0.1.0",
  "identifier": "io.yourservice.ov-runner",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OV Runner",
        "width": 420,
        "height": 560,
        "resizable": false,
        "visible": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "macOS": { "category": "public.app-category.developer-tools" }
  }
}
