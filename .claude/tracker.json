{
  "tracker": {
    "provider": "github",
    "repo": "farol-team/slack"
  },
  "states": {
    "icebox": "flow:icebox",
    "backlog": "flow:backlog",
    "triage": "flow:triage",
    "human_questions": "flow:human-questions",
    "plan_proposed": "flow:plan-proposed",
    "ready": "flow:ready",
    "in_progress": "flow:in-progress",
    "review": "flow:review",
    "blocked": "flow:blocked",
    "done": "flow:done"
  },
  "auto_merge_criteria": {
    "min_confidence": 7,
    "require_ci_green": true,
    "max_risk": "medium",
    "strategy": "merge"
  },
  "research": {
    "marker": "[research]",
    "doc_dir": "research",
    "target_repo": ".",
    "route": "review"
  },
  "epic": {
    "marker": "[epic]",
    "label_prefix": "epic:",
    "auto_refresh_checklist": true,
    "auto_create_min_cluster": 3
  },
  "labels": {
    "ai_generated": "ai-generated"
  },
  "worker": {
    "max_turns": 100,
    "model": "",
    "resume_sessions": true
  },
  "acceptance": {
    "max_turns": 50,
    "model": ""
  },
  "tdd_gate": {
    "enabled": true,
    "min_size": "M",
    "min_risk": "medium",
    "max_spec_iterations": 2
  },
  "split_confirmation_phrase": "split confirmed",
  "card_prefix": "FRL",
  "branch_prefix": "flow/",
  "default_target": "app",
  "repo_label_prefix": "repo:",
  "targets": {
    "app": {
      "repo_root": ".",
      "worktree_root": ".flow/worktrees",
      "worker_log_dir": ".flow/worker-logs",
      "branch_prefix": "flow/",
      "toolchain": "node",
      "test_cmd": "cd app && npm test",
      "lint_cmd": "cd app && npm run check && npm run lint"
    },
    "cloud": {
      "repo_root": ".",
      "worktree_root": ".flow/worktrees",
      "worker_log_dir": ".flow/worker-logs",
      "branch_prefix": "flow/",
      "toolchain": "python",
      "test_cmd": "cd cloud && python -m compileall -q app",
      "lint_cmd": "cd cloud && python -m compileall -q app"
    },
    "runner": {
      "repo_root": ".",
      "worktree_root": ".flow/worktrees",
      "worker_log_dir": ".flow/worker-logs",
      "branch_prefix": "flow/",
      "toolchain": "rust",
      "test_cmd": "cd runner && cargo test --workspace",
      "lint_cmd": "cd runner && cargo check --workspace"
    }
  },
  "project_context_docs": [
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "session_log": ".flow/session-log.md",
  "learnings": ".claude/learnings.jsonl",
  "comment_prefixes": {
    "meta": "[meta] ",
    "worker": "[worker] "
  }
}
